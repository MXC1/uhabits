<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?windowBackgroundColor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        app:popupTheme="?toolbarPopupTheme"
        android:layout_alignParentTop="true" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/outerLinearLayout"
            style="@style/CardList"
            android:clipToPadding="false">

            <LinearLayout
                style="@style/Card"
                android:paddingTop="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:theme="@style/SmallSpinner" />

                    <TextView
                        android:id="@+id/totalScoreTitle"
                        style="@style/CardHeader"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:text="@string/global_score_today" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/totalScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="?contrast100"
                    android:text="--" />

                <TextView
                    android:id="@+id/visibleHabits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:textColor="?contrast60"
                    android:text="" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_visible_habits_to_score"
                    android:textColor="?contrast60"
                    android:visibility="gone" />

                <org.isoron.uhabits.activities.common.views.ScoreChart
                    android:id="@+id/scoreView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/moversCard"
                style="@style/Card"
                android:paddingTop="6dp"
                android:visibility="gone">

                <TextView
                    style="@style/CardHeader"
                    android:text="@string/top_movers" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="?contrast100"
                    android:textStyle="bold"
                    android:text="@string/biggest_increases" />

                <LinearLayout
                    android:id="@+id/gainerRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gainerName1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/gainerChange1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/gainerFill1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                        <View
                            android:id="@+id/gainerSpacer1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:id="@+id/gainerDivider1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="?contrast20" />

                <LinearLayout
                    android:id="@+id/gainerRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gainerName2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/gainerChange2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/gainerFill2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                        <View
                            android:id="@+id/gainerSpacer2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:id="@+id/gainerDivider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="?contrast20" />

                <LinearLayout
                    android:id="@+id/gainerRow3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/gainerName3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/gainerChange3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/gainerFill3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                        <View
                            android:id="@+id/gainerSpacer3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/noGainers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?contrast60"
                    android:text="@string/no_movers_yet"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="?contrast100"
                    android:textStyle="bold"
                    android:text="@string/biggest_decreases" />

                <LinearLayout
                    android:id="@+id/declinerRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/declinerName1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/declinerChange1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/declinerSpacer1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:id="@+id/declinerFill1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:id="@+id/declinerDivider1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="?contrast20" />

                <LinearLayout
                    android:id="@+id/declinerRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/declinerName2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/declinerChange2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/declinerSpacer2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:id="@+id/declinerFill2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:id="@+id/declinerDivider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="?contrast20" />

                <LinearLayout
                    android:id="@+id/declinerRow3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/declinerName3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="?contrast100" />

                        <TextView
                            android:id="@+id/declinerChange3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?contrast60" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="?contrast20"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/declinerSpacer3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <View
                            android:id="@+id/declinerFill3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/noDecliners"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?contrast60"
                    android:text="@string/no_movers_yet"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
